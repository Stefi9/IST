@echo off

:: 32-Bit platform detection
if "%PROCESSOR_ARCHITECTURE%"=="x86" (
    if defined PROCESSOR_ARCHITEW6432 (
        echo SYSERROR: IST cannot run on the WoW64 ^(Windows 32-Bit for Windows 64-Bit^) plugin.
        echo Please restart IST in normal mode.
        echo ERROR-CODE: 0x32
        pause
        exit /b
        GOTO :EOF
    ) else (
        echo SYSERROR: IST cannot run on a 32-Bit OS.
        echo So, IST is not supported on your machine.
        echo ERROR-CODE: 0x32
        pause
        exit /b
        GOTO :EOF
    )
) else (
    echo 64-Bit OS detected. >nul
)

:: Variables

:: SETLOCAL
SETLOCAL
SETLOCAL EnableDelayedExpansion

:: cmdCount
set "cmdCount=60"
set "nCmdCount=0"

:: Version
set "version=1.8"
set "istncdVER=1.4"

:: The directory of IST
set "istDir=%~dp0"
:: PATH block (for PATH users)
where ist.bat >nul 2>&1
if "%ERRORLEVEL%" EQU 0 (
    FOR /F "tokens=*" %%i IN ('where ist.bat') DO SET istDir=%%i
)
:: The type of IST
  :: install (Program files)
if exist "%PROGRAMFILES%\IST\IST.bat" (
        set "type=install"
        set "istPgf=%PROGRAMFILES%\IST"
)
  :: Portable
if not exist "%PROGRAMFILES%\IST\IST.bat" (
        set "type=portable"
        set "istPgf=%istDir%"
)

:: Administrator rights?
net session >nul 2>&1
if %errorLevel% == 0 (
    set "admStat=1"
    set "admLab=[ADMIN]"
) else (
    set "admStat=0"
    set "admLab=[USER]"
)

:: Title Variable
set "titVar=IST %version% %admLab%"
:: Title
title %titVar%

:: Lines of Code (and previous)
set "prvLineCount=1928"
set "lineCount=0"
for /f %%a in ('find /c /v "" ^< "%~f0"') do set "lineCount=%%a"

:: Banner
for /f "tokens=2 delims=:" %%a in ('mode con ^| findstr Columns') do set /a "cols=%%a-2"
set "line="
for /l %%i in (1,1,%cols%) do set "line=!line!="
set /a "padding=(cols - 35) / 2"
set "spaces="
for /l %%i in (1,1,%padding%) do set "spaces=!spaces! "

:: YOLO through DeadZone
set "YOLO=0"
for %%x in (%*) do if /i "%%x"=="--yolo" set "YOLO=1"

:: Log Maintenance: Prevent infinite growth
if exist "%istPgf%\log-files" (
    powershell -NoProfile -Command "$path='%istPgf%\log-files\Actions.txt'; if(Test-Path $path){ if((Get-Item $path).Length -gt 500KB){ Clear-Content $path } }"
)

:: Configuration for theme loader
if exist "%istPgf%\bin\themeManager.ist" (
    set /p CfgTheme=<"%istPgf%\bin\themeManager.ist"
    if "!CfgTheme!"=="Hackerman" (Color 02)
    if "!CfgTheme!"=="Ocean" (Color 17)
    if "!CfgTheme!"=="WinPWSH" (Color 1F)
    if "!CfgTheme!"=="Blood" (color 04)
    if "!CfgTheme!"=="Winter" (color F0)
    if "!CfgTheme!"=="Volcano" (color 4E)
    if "!CfgTheme!"=="Default" (color 07)
)

:: Sad smiley
set "sSM=:("

:: Flags system 

:: Checks the internet
IF /i "%1"=="-check-network"            GOTO NETWORK
:: Shows your IPv4 address
IF /i "%1"=="-ip"                       GOTO IP
:: Show the DNS of a domain
IF /i "%1"=="-dns"                      GOTO DNS
:: Pings server chosen
IF /i "%1"=="-ping"                     GOTO PING
:: Clears the cache for the DNS on your computer to maybe fix your network issues
IF /i "%1"=="-flushdns"                 GOTO FLUSH
:: Shows information about internet in general on your device
IF /i "%1"=="-info"                     GOTO INFO
:: Shows the mac address
IF /i "%1"=="-mac"                      GOTO MAC
:: What is the set name to make the network recognize this device
IF /i "%1"=="-hostname"                 GOTO HOSTNAME
:: Shows how long the network card was turned on
IF /i "%1"=="-listend-ports"            GOTO LISPORT
:: Shows what apps use the internet right now
IF /i "%1"=="-apps"                     GOTO APPS 
:: Shows you a refreshing view, of how much data is being sent and received every 3 seconds
IF /i "%1"=="-monitor"                  GOTO MONITOR
:: Maximum reachable speed
IF /i "%1"=="-max-speed"                GOTO MAXSPEED
:: Show every connected network on the windows device
IF /i "%1"=="-list-connected-nets"      GOTO LCN
:: Shows WiFi Password
IF /i "%1"=="-list-pass"                GOTO PASS
:: Shows WiFi Info of a specified WiFi network
IF /i "%1"=="-list-wifi-info"           GOTO LWINFO
:: Shows what other IPs/URLs a website needs before you can use it
IF /i "%1"=="-trace"                    GOTO TRACE
:: Shows Currently active IPs
IF /i "%1"=="-active-ips"               GOTO ACTIVE
:: Shows DNS cache that built up by the internet
IF /i "%1"=="-dns-cache-history"        GOTO HISTORY
:: Installes Drivers
IF /i "%1"=="-install-drivers"          GOTO DRIVERS
:: Lists how many bytes were Recieved and Sent
IF /i "%1"=="-usage"                    GOTO USAGE
:: Shows Status for every network adapter
IF /i "%1"=="-adapter-status"           GOTO ADAPTERSTATUS
:: Shows the Gateway of your Internet Connection
IF /i "%1"=="-gateway"                  GOTO GATE
:: Initial Setup wizard
if /i "%~1"=="--install"                GOTO SETUP
:: Changes to the wanted DNS
IF /i "%1"=="-set-dns"                  GOTO SETDNS
:: Shows all Log Files 
IF /i "%1"=="-show-log"                 GOTO LOG
:: shows if IST hasw updates
IF /i "%1"=="--update"                  GOTO UPDATE
:: Optimizes the windows device
IF /i "%1"=="-optimize"                 GOTO OPTIMIZE
:: Shows the Type of IST you are using (portable or installed)
IF /i "%1"=="-type"                     GOTO TYPE
:: Exports all Logs to the Desktop
IF /i "%1"=="-export-log"               GOTO EXPORTLOG
:: Restarts the Terminal
IF /i "%1"=="-restart"                  GOTO RESTART
:: Reinstalls IST
IF /i "%1"=="--reinstall"               GOTO REINSTALL
:: See The time, when IST was installed as local program
IF /i "%1"=="-installed-time"           GOTO INTTIME
:: Is the Internet Working?
IF /i "%1"=="-check-use"                GOTO CHECKUSE
:: Shows Connection Type
IF /i "%1"=="-connection"               GOTO CONNECTION
:: Lists All Logs to IST
IF /i "%1"=="-show-log-amount"          GOTO LOGAM
:: Shows What is new to IST
IF /i "%1"=="--whats-new"               GOTO WN
:: Shows Information of a given Error Code
IF /i "%1"=="--error-codes"             GOTO EC
:: TUI
IF /i "%1"=="--tui"                     GOTO CHECK_INTEGRITY
:: Checks the Proxy
IF /i "%1"=="-check-proxy"              GOTO CHECKPROXY
:: Coverty Bits to Bytes
IF /i "%1"=="-convert-bits"             GOTO CONVERTBYTES
:: Exports the Configs
IF /i "%1"=="-export-configs"           GOTO EXPORTCONFS
:: Changes FireWall rules
IF /i "%1"=="-set-firewall-rules"       GOTO SFIREWALLR
:: Cleans the IST made log files
IF /i "%1"=="-clean-logs"               GOTO CLEANLOGS
:: Changes the terminal theme
IF /i "%1"=="-theme"                    GOTO THEME
:: Shows the VPN status
IF /i "%1"=="-vpn-status"               GOTO VPNSTAT
:: Shows tips about networking
IF /i "%1"=="-networking-tips"          GOTO NETTIPS
:: Shows the open ports
IF /i "%1"=="-open-ports"               GOTO OPENPORT
:: Shows information about your IP
IF /i "%1"=="-ip-info"                  GOTO IPINFO

:: DEAD ZONE
:: Makes a new IP address
IF /i "%1"=="--DeadZone-renew"          GOTO DEADRENEW
:: Removes The IST network configuration driver
IF /i "%1"=="--DeadZone-remove-driver"  GOTO DEADRMDRIVER
:: Resets WinSock (WARNING: it is not a sock)
IF /i "%1"=="--DeadZone-rmwinsock"      GOTO DEADRMSOCK
:: Makes a new IP address
IF /i "%1"=="--DeadZone-reset-firewall" GOTO DEADFIRE
:: Turns IPv6 off
IF /i "%1"=="--DeadZone-ipv6-off"       GOTO DEADIPV6
:: Resets WinSock (WARNING: it is not a sock)
IF /i "%1"=="--DeadZone-set-dns"        GOTO DEADDNS
:: Uninstalls IST
if "%1"=="--deadzone-uninstall"         GOTO DEADUNINSTALL
:: Resets ARP
IF /i "%1"=="--deadzone-reset-arp"      GOTO DEADRSARP
:: Goes to the DeadZone Version of TUI
IF /i "%1"=="--deadzone-tui"            GOTO TUI-DEAD

:: Internal commands
IF /i "%1"=="--123456789-123456789"     GOTO 123456789-123456789
if /i "%~1"=="--EXEC-UNINSTALL"         GOTO :PROCEED_UNINSTALL

:: Others
:: Help centre
IF /i "%1"==""                          GOTO USE
:: Also help centre
IF /i "%1"=="--help"                    GOTO HELP
:: Shows version
IF /i "%1"=="--version"                 GOTO VERSION

:: For everything else, that is not recognized
IF /i NOT "%1"==""                      GOTO USE


:NETWORK
set "spdExe=speedtest"
where %spdExe% >nul 2>nul
if %errorlevel% neq 0 (
    echo [ ERROR ] Speedtest CLI not found in PATH.
    GOTO :EOF
)
echo Running Speed Test...
call %spdExe% --accept-license --accept-gdpr
GOTO :EOF

:IP
echo Showing your IP address is a serious business! Do not show this during a stream or someone that you don't want unauthorized access to your IP address. 
set /p "YNIP=Are you sure you want to continue? (y/n): "
if "%YNIP%"=="y" (
    :: This shows your local and public IP info
    echo Your Local IP Information:
    ipconfig | findstr "IPv4"
    echo.
    echo Your Public IP:
    powershell -NoProfile -Command "(Invoke-RestMethod -Uri 'https://api.ipify.org')"
) else (
    echo Aborted, security risk forbidden.
)
GOTO :EOF

:DNS
if "%2"=="" (
    echo Please specify a domain (e.g., ist -dns google.com)
    GOTO :EOF
) else (
    echo Resolving IPs for %2...
    nslookup %2 | findstr /i "address"
)
GOTO :EOF

:PING
:: 1. Ask who to ping
set "target="
set /p "target=Ping who? (Leave blank for google.com): "
if "%target%"=="" set "target=google.com"

:: 2. Ask if it should be continuous
set /p "ptype=do you want to ping %target% continuously? (y/n): "

echo.
if /i "%ptype%"=="y" (
    echo Pinging %target% continuously... Press CTRL+C to stop
    ping %target% -t
) else (
    echo Pinging %target%...
    ping %target%
)
GOTO :EOF

:FLUSH
echo Flushing DNS cache...
ipconfig /flushdns
GOTO :EOF

:INFO
echo Getting info...
getmac /v
GOTO :EOF

:MAC
echo Getting MAC address...
getmac
GOTO :EOF

:HOSTNAME
echo Showing the name of the windows device...
hostname
GOTO :EOF

:LISPORT
echo Finding Listening ports...
netstat -an | findstr "LISTENING"
GOTO :EOF

:APPS
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: '-apps' requires Administrator permission. Please try again
    echo ERROR-CODE: 0x2
    GOTO :EOF
)

echo Listing apps using the internet...
echo (This may take a few seconds)
netstat -b
GOTO :EOF

:MONITOR
echo To cancel, click CTRL + C
netstat -s 5
GOTO :EOF

:MAXSPEED
:: Detect the parent process
set "shell=cmd"
tasklist /fi "pid eq %PPID%" 2>nul | findstr /i "pwsh powershell" >nul && set "shell=powershell"

if "%shell%"=="powershell" (
    Get-NetAdapter | Select-Object Name, LinkSpeed
) else (
    powershell -NoProfile -Command "Get-NetAdapter | Select-Object Name, LinkSpeed"
)
GOTO :EOF

:LCN
echo Showing connected networks...
netsh wlan show profiles
GOTO :EOF

:PASS
:: Temporarily disable the DelayedExpansion for use of !
setlocal DisableDelayedExpansion
set /p "wifiName=What Wi-Fi do you want to get the password?: "
echo Searching for password...
for /f "tokens=2 delims=:" %%A in ('netsh wlan show profile name^="%wifiName%" key^=clear ^| findstr "Key Content"') do (
    set "wifiPass=%%A"
)
set "wifiPass=%wifiPass:~1%"
:: Display the result
echo The password is: %wifiPass%
:: Clear the variable
set "wifiPass="
:: EnableDelayedExpansion back
setlocal EnableDelayedExpansion
GOTO :EOF

:LWINFO
:: Temporarily disable the DelayedExpansion for use of !
setlocal DisableDelayedExpansion
set /p "wifiName=What Wi-Fi do you want to get the info?: "
netsh wlan show profile name="%wifiName%" key=clear
:: EnableDelayedExpansion back
setlocal EnableDelayedExpansion
GOTO :EOF

:TRACE
if "%~2"=="" (
    echo Error: No target provided.
    echo Usage: ist -trace [url/IP]
    echo ERROR-CODE: 0x102
    GOTO :EOF
)

echo Tracing route to %~2...
echo [TIP] Press Ctrl+C to cancel if it takes too long.
echo.
tracert -d -h 15 %~2

if %errorlevel% neq 0 (
    echo.
    echo Trace failed. Check your internet or the URL spelling.
    echo ERROR-CODE: 0x102
)
GOTO :EOF

:ACTIVE
netstat -n | findstr "ESTABLISHED"
GOTO :EOF

:HISTORY
ipconfig /displaydns | findstr "Record Name"
GOTO :EOF

:DRIVERS
:: Administrator rights?
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo ERROR: Installing the drivers for IST, REQUIRES administrator rights.
    echo Please restart the terminal as administrator.
    echo ERROR-CODE: 0x2
    GOTO :EOF
)

set "TitleDrivers=      IST %version% - Driver Installer"
echo !line!
echo !spaces!!TitleDrivers!
echo !line!
title IST %version% - Drivers Installer
echo 1. Speedtest CLI (ist -check-network)
echo 2. Updates the drivers
set /p "choice=Select drivers (A for All, Q to quit): "

if "%choice%"=="1" (
    GOTO SPEEDTESTDRIVER
    GOTO :EOF
)
if "%choice%"=="2" (
    GOTO DRIVERUPDATE
    GOTO :EOF
)
if /i "%choice%"=="a" (
    GOTO ALLDRIVERS
    GOTO :EOF
)
if /i "%choice%"=="q" (
    GOTO :EOF
)
echo Invalid Selection
GOTO :EOF


:SPEEDTESTDRIVER
where winget >nul 2>nul
if %errorlevel% NEQ 0 (
    powershell -NoProfile -Command "$s='|','/','-','\'; for($i=0;$i -lt 5;$i++){ foreach($c in $s){ write-host -NoNewline (\"`rInstalling Speedtest CLI... $c\"); Start-Sleep -m 100 } }"
    winget install --id Ookla.Speedtest.CLI -e --silent --accept-source-agreements --accept-package-agreements
) else (
    echo [!] Winget not found. Falling back to Manual Download...
    :: Create the folder if it doesn't exist
    if not exist "%istPgf%\bin" mkdir "%istPgf%\bin"
    :: Download the Speedtest CLI directly via PowerShell
    powershell -NoProfile -Command "Invoke-WebRequest -Uri 'https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-win64.zip' -OutFile '%TEMP%\speedtest.zip'"
    powershell -NoProfile -Command "Expand-Archive -Path '%TEMP%\speedtest.zip' -DestinationPath '%istPgf%\bin' -Force"
    
    echo [ OK ] Speedtest CLI manually installed to %istPgf%\bin. (default Core folder)
)
GOTO :EOF

:DRIVERUPDATE
echo Checking for driver updates...
where winget >nul 2>nul
if %errorlevel% == 0 (
    echo Checking for Speedtest CLI updates...
    winget upgrade --id Ookla.Speedtest.CLI --silent --accept-source-agreements >nul 2>&1
    if %errorlevel% == 0 (echo [ OK ] Speedtest CLI is up to date.) else (echo [!] Speedtest CLI updated.)
)
echo All drivers are now at the latest version.
GOTO :EOF

:ALLDRIVERS
:: Speed test Driver
where winget >nul 2>nul
if %errorlevel% == 0 (
    powershell -NoProfile -Command "$s='|','/','-','\'; for($i=0;$i -lt 5;$i++){ foreach($c in $s){ write-host -NoNewline (\"`rInstalling Speedtest CLI... $c\"); Start-Sleep -m 100 } }"
    winget install --id Ookla.Speedtest.CLI -e --silent --accept-source-agreements --accept-package-agreements
    echo [ OK ] - Speedtest CLI was installed to the Winget location.
) else (
    echo [!] Winget not found. Manual Download...
    :: Create the folder if it doesn't exist
    if not exist "%istPgf%\bin" mkdir "%istPgf%\bin"
    :: Download the Speedtest CLI directly via PowerShell
    powershell -NoProfile -Command "Invoke-WebRequest -Uri 'https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-win64.zip' -OutFile '%TEMP%\speedtest.zip'"
    powershell -NoProfile -Command "Expand-Archive -Path '%TEMP%\speedtest.zip' -DestinationPath '%istPgf%\bin' -Force"
    
    echo [ OK ] - Speedtest CLI manually installed to %istPgf%\bin. (default Core folder)
)
GOTO :EOF

:USAGE
echo Gathering Info...
netstat -e
GOTO :EOF

:ADAPTERSTATUS
echo Listing Status...
netsh int show interface
GOTO :EOF

:GATE
echo Showing...
ipconfig | findstr "Gateway"
GOTO :EOF

:SETUP
set "STtitle=IST: Internet Servicing Tool Full Setup wizard"
echo !line!
echo !spaces!!STtitle!
echo !line!
if exist "%PROGRAMFILES%\IST\IST.bat" (
    echo ERROR: IST is already installed.
    echo Use '-uninstall' to remove.
    echo ERROR-CODE: 0x1
    GOTO :EOF
)

net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Setting IST fully up, REQUIRES Administrator privileges.
    echo Please Restart the terminal as Administrator.
    echo ERROR-CODE: 0x2
    GOTO :EOF
)

echo Starting Full Setup...

:: 1/5, ProgramFiles Add
echo [1/5] Installing IST as Local Program...
mkdir "%PROGRAMFILES%\IST"
mkdir "%PROGRAMFILES%\IST\log-files"
mkdir "%PROGRAMFILES%\IST\external-scripts"
mkdir "%PROGRAMFILES%\IST\bin"
:: Log Data [1/5]
echo [%date% %time%] Created Installation Folder "%PROGRAMFILES%\ist" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"
echo [%date% %time%] Created Installation Folder "%PROGRAMFILES%\ist\log-files" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"
echo [%date% %time%] Created Installation Folder "%PROGRAMFILES%\ist\external-scripts" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"
echo [ OK ] Made Installation folders and files

:: 2/5, Drivers
echo [2/5] Installing Drivers (Auto-selecting 'A')...
:: Use 'echo a |' to feed the input into the call
echo a | call "%~f0" -install-drivers >nul
:: Log Data [2/10]
echo [%date% %time%] Installed Drivers >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"

:: 3/5, setting IST as PATH
echo [3/5] Setting IST to systems PATH...
powershell -NoProfile -Command "[Environment]::SetEnvironmentVariable('Path', [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';%PROGRAMFILES%\IST', 'Machine')"
echo [ OK ] Set IST in Systems PATH.

:: 4/5, Flushing DNS, thus uptimizing the system 
echo [4/5] Flushing DNS and optimizing...
call "%~f0" -flushdns >nul
echo [%date% %time%] Flushed the DNS >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"


:: 5/5, Moving IST
echo [5/5] Moving IST to ProgramFiles...
echo [ NOTICE ] while IST is moving, IST cannot do other commmands at the same time while moving
copy /y "%~f0" "%PROGRAMFILES%\IST\IST.bat" >nul
echo Installation Complete!
start "" "%PROGRAMFILES%\IST\IST.bat"
echo [%date% %time%] Moved IST into "%PROGRAMFILES%\IST" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"

:: Finishing
echo Finishing Installation...
echo Installation Finished.

echo Restarting the Terminal
call "%~f0" -restart >nul
GOTO :EOF

:SETDNS
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Setting a custom DNS, REQUIRES Administrator privileges.
    echo Please Restart the terminal as Administrator.
    echo ERROR-CODE: 0x2
    GOTO :EOF
)
echo presets:
echo ist -set-dns gaming
echo ist -set-dns stability
echo ist -set-dns google
echo ist -set-dns cloudflare
echo ist -set-dns security
echo ist -set-dns ad-protection

:: 1. Define the Presets (The "Database")
set "gaming=1.0.0.1"
set "stability=8.8.4.4"
set "google=8.8.8.8"
set "cloudflare=1.1.1.1"
set "security=9.9.9.9"
set "ad-protection=94.140.14.14"

:: 2. The Bridge: Point %primary% to the chosen preset
set "primary=!%~2!"

:: 3. Validation: Make sure the user didn't type a fake preset
if "%primary%"=="" (
    echo ERROR: '%~2' is not a valid preset.
    echo Use: gaming, stability, google, cloudflare, etc.
    echo ERROR-CODE: 0x102
    GOTO :EOF
)

:: 4. The Action
echo Applying %~2 DNS (%primary%)...
netsh interface ip set dns name="%adapter%" source=static address=%primary%
ipconfig /flushdns >nul
echo [ OK ] DNS updated successfully.
GOTO :EOF

:LOG
type "%istPgf%\log-files\Installation-log.txt"
GOTO :EOF

:UPDATE
:: Administrator Rights?
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Updating IST, REQUIRES Administrator privileges.
    echo Please Restart the terminal as Administrator.
    echo ERROR-CODE: 0x2 
    GOTO :EOF
)
for /f "usebackq tokens=*" %%a in (`powershell -NoProfile -Command "(Invoke-RestMethod -Uri 'https://api.github.com/repos/Stefi9/IST/releases/latest').tag_name"`) do set "latest_version=%%a"

if "%version%"=="%latest_version%" (
    echo [ OK ] You are up to date (%version%)
) else (
    echo Update available! - %latest_version%
    set /p "YNUPD=Do you want to update to %latest_version%? (y/n) "
    if "!YNUPD!"=="y" (
        echo Downloading...
        set "zipURL=https://github.com/Stefi9/IST/releases/latest/download/IST.zip"
        set "destination=%USERPROFILE%\Downloads\update.zip"
        powershell -NoProfile -Command "Invoke-WebRequest -Uri '!zipURL!' -OutFile '!destination!'"
        echo Extracting...
        powershell -NoProfile -Command "Expand-Archive -Path '!destination!' -DestinationPath '%istPgf%' -Force"
        del !destination!
        echo [ OK ] IST has been updated to !latest_version!.
    ) else (
        echo Aborted, IST stays at version %version%
    )
)  
GOTO :EOF

:OPTIMIZE
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Optimizing (fully), REQUIRES Administrator privileges.
    echo Please Restart the terminal as Administrator.
    echo ERROR-CODE: 0x2
    GOTO :EOF
)
echo.
ipconfig /flushdns >nul
echo [%date% %time%] Flushed DNS >> "%PROGRAMFILES%\IST\log-files\Optimization-log.txt"
netsh int ipv6 set teredo disabled
echo [%date% %time%] Disabled IPv6 >> "%PROGRAMFILES%\IST\log-files\Optimization-log.txt"
netsh int ip set dns "Wi-Fi" static 8.8.8.8
echo [%date% %time%] Set DNS to Google's DNS >> "%PROGRAMFILES%\IST\log-files\Optimization-log.txt"
echo [ OK ] Device was Optmized successfully.
GOTO :EOF

:TYPE
echo Your IST version is %type%
GOTO :EOF

:EXPORTLOG
copy "%istPgf%\log-files" "%USERPROFILE%\Desktop\"
GOTO :EOF

:RESTART
start cmd.exe
exit
GOTO :EOF

:REINSTALL
set "RTtitle=IST: Internet Servicing Tool Reinstallation"
echo !line!
echo !spaces!!RTtitle!
echo !line!

if not exist "%PROGRAMFILES%\IST\IST.bat" (
    echo ERROR: IST is not installed in Program Files.
    echo There is nothing to reinstall.
    echo ERROR-CODE: 0x01
    GOTO :EOF
)

net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Reinstalling IST, REQUIRES Administrator privileges.
    echo Please Restart the terminal as Administrator.
    echo ERROR-CODE: 0x2
    GOTO :EOF
)
:: 1. Check if we are currently running from the folder we want to delete
if /i "%~dp0"=="%PROGRAMFILES%\IST\" (
    :: Copy the script to the Windows Temp folder
    copy /y "%~f0" "%temp%\IST_Updater.bat" >nul
    
    :: Run the copy from the Temp folder and tell it to skip back to the reinstall logic
    start "" "%temp%\IST_Updater.bat" --123456789-123456789
    
    :: Close this version immediately so the folder is no longer "in use"
    exit /b
)

:123456789-123456789
:: 1/4, Keeping IST in Downloads as Portable Program
echo [1/4] Keeping IST in Downloads as a Portable Program...
copy /y "%~f0" "%USERPROFILE%\Downloads\IST_Portable.bat"
echo [ OK ] moved IST in downloads as a Portable Program

:: 2/5, Removing Files
echo [2/4] Removing Files...
rd /s /q "%PROGRAMFILES%\IST"
echo [ OK ] Removed Files.

:: 3/4, removing IST from PATH
echo [3/4] Remowing IST from PATH...
powershell -NoProfile -Command "$p=[Environment]::GetEnvironmentVariable('Path','Machine'); $p=$p -replace ';%PROGRAMFILES:\=\\%\\IST',''; [Environment]::SetEnvironmentVariable('Path',$p,'Machine')"

:: 4/4, Flushing DNS, thus uptimizing the system 
echo [4/4] Flushing DNS and optimizing...
call "%~f0" -flushdns >nul
echo [ OK ] Flushing DNS finished.

:: Finishing
echo Finishing Uninstallation...
echo Uninstallation Finished.

:: 1/5, ProgramFiles Add
echo [1/5] Installing IST as Local Program...
mkdir "%PROGRAMFILES%\IST"
mkdir "%PROGRAMFILES%\IST\log-files"
mkdir "%PROGRAMFILES%\IST\external-scripts"
mkdir "%PROGRAMFILES%\IST\bin"
:: Log Data [1/4]
echo [%date% %time%] Created Installation Folder "%PROGRAMFILES%\ist" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"
echo [%date% %time%] Created Installation Folder "%PROGRAMFILES%\ist\log-files" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"
echo [%date% %time%] Created Installation Folder "%PROGRAMFILES%\ist\external-scripts" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"
echo [ OK ] Made Installation folders and files

:: 2/5, Drivers
echo [2/5] Installing Drivers (Auto-selecting 'A')...
:: Use 'echo a |' to feed the input into the call
echo a | call "%~f0" -install-drivers >nul
:: Log Data [2/4]
echo [%date% %time%] Installed Drivers >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"

:: 3/5, setting IST as PATH
echo [3/5] Setting IST to systems PATH...
powershell -NoProfile -Command "[Environment]::SetEnvironmentVariable('Path', [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';%PROGRAMFILES%\IST', 'Machine')"
echo [ OK ] Set IST in Systems PATH.

:: 4/5, Flushing DNS, thus uptimizing the system 
echo [4/5] Flushing DNS and optimizing...
call "%~f0" -flushdns >nul
:: Log Data [3/4]
echo [%date% %time%] Flushed the DNS >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"


:: 5/5, Moving IST
echo [5/5] Moving IST to ProgramFiles...
echo [ NOTICE ] while IST is moving, IST cannot do other commmands at the same time while moving
copy /y "%~f0" "%PROGRAMFILES%\IST\IST.bat" >nul
echo Installation Complete!
start "" "%PROGRAMFILES%\IST\IST.bat"
:: Log Data [4/4]
echo [%date% %time%] Moved IST into "%PROGRAMFILES%\IST" >> "%PROGRAMFILES%\IST\log-files\Installation-log.txt"

:: Finishing
echo Finishing Installation...
echo Installation Finished.

echo Restarting the Terminal
call "%~f0" -restart >nul
GOTO :EOF

